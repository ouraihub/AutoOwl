{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop capability for the AutoOwl main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "aether:logs",
    "aether:mcp-server-read",
    "aether:mcp-server-control",
    "aether:providers",
    "aether:chat",
    "aether:chat-history"
  ]
}
